{
  "name": "job-pipeline-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "vinext start",
    "test": "vitest run",
    "engine": "node scripts/engine.ts",
    "muse": "node scripts/muse-hatch.ts",
    "muse:cli": "node scripts/muse-start.ts",
    "privacy:check": "node scripts/check-publication-privacy.ts",
    "typecheck": "tsc --noEmit",
    "privacy:history": "node scripts/check-publication-privacy.ts --history",
    "check": "npm run privacy:check && npm run typecheck && npm test -- --maxWorkers=2 && npm run build"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "lucide-react": "^1.63.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-server-dom-webpack": "^19.3.1",
    "vinext": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "latest",
    "@vitejs/plugin-rsc": "latest",
    "typescript": "^5.9.0",
    "vite": "^8.3.5",
    "vitest": "latest"
  },
  "description": "Local-first job search automation with human approval, observable execution and an event-driven engine.",
  "license": "MIT",
  "engines": {
    "node": "^22.18.0 || >=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/murphylan/jobpipe.git"
  },
  "bugs": {
    "url": "https://github.com/murphylan/jobpipe/issues"
  }
}
